	draw_text_yxa(320,192,"BASED ON YAYSUU'S X-TREME ADVENTURE","white",false)
	break;
	case 2:
	draw_text_yxa(320,160,"- Artist, Programmer, Musician -","dgray",false)
	draw_text_yxa(320,176,"JasperFella","white",false)
	draw_text_yxa(320,208,"- Minor Artist, Programming Help -","dgray",false)
	draw_text_yxa(320,224,"Fazmade","white",false)
	break;
	case 4:
	draw_text_yxa(320,160,"- Software Used -","dgray",false)
	draw_text_yxa(320,176,"Piskel","white",false)
	draw_text_yxa(320,192,"Paint.net","white",false)
	draw_text_yxa(320,208,"Audacity","white",false)
	draw_text_yxa(320,224,"UltraBox","white",false)
	break;
	case 5:
	draw_text_yxa(320,160,"- Special Thanks -","dgray",false)

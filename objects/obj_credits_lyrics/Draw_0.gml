draw_set_halign(fa_center)
switch slide
{
	case 1:
	draw_text_yxa(320,400,"Void","white",false)
	break;
	case 2:
	draw_text_yxa(320,400,"The white expanse","white",false)
	break;
	case 3:
	draw_text_yxa(320,400,"Claims back","white",false)
	break;
	case 4:
	draw_text_yxa(320,400,"The world of color that was","white",false)
	break;
	case 5:
	draw_text_yxa(320,400,"No rhyme or reason","white",false)
	break;
	case 6:
	draw_text_yxa(320,400,"Just because","white",false)
	break;
	case 8:
	draw_text_yxa(320,400,"As it crumbles down","white",false)
	break;
	case 9:
	draw_text_yxa(320,400,"Silence where there was sound","white",false)
	break;
	case 10:
	draw_text_yxa(320,400,"I simply ask","white",false)
	break;
	case 11:
	draw_text_yxa(320,400,"Forget me not","white",false)
	break;
}